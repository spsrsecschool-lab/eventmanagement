{
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "fonts/**"
    }
  },
  "headers": [
    { "source": "/((?!api/og-image).*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] }
  ]
}
